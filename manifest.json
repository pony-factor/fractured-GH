{
  "manifest_version": 3,
  "name": "Fractured GitHub",
  "version": "0.7.0",
  "description": "Personal GitHub interface tweaks.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fractured GitHub",
    "default_icon": {
      "16": "icons/fractured-16.png",
      "32": "icons/fractured-32.png",
      "48": "icons/fractured-48.png",
      "128": "icons/fractured-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "features/pony-headings.css",
        "features/promote-display-names.css"
      ],
      "js": [
        "features/hide-inbox-while-busy.js",
        "features/hide-copilot.js",
        "features/hide-my-navigation-links.js",
        "features/owner-avatar-header.js",
        "features/user-nicknames.js",
        "features/promote-display-names.js",
        "features/mute-users.js",
        "features/block-tooltips.js",
        "features/hide-contributing-guidelines-notice.js",
        "features/hide-pull-request-protip.js",
        "features/hide-pull-request-milestone.js",
        "features/hide-footer.js",
        "features/hide-suggested-workflows.js",
        "features/hide-repository-languages.js",
        "features/hide-unused-repository-tabs.js",
        "features/organization-notifications.js",
        "features/relative-times.js",
        "features/commit-title-emojis.js",
        "features/commit-message-simplifier.js",
        "features/hide-notification-reason.js",
        "features/hide-empty-development-copy.js",
        "features/wrap-diff-lines.js",
        "features/spellcheck-issue-pr-drafts.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "features/spellcheck-chatgpt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/CelestiaMediumRedux.ttf"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/fractured-16.png",
    "32": "icons/fractured-32.png",
    "48": "icons/fractured-48.png",
    "128": "icons/fractured-128.png"
  }
}
