{
  "manifest_version": 3,
  "name": "Fractured GitHub",
  "version": "0.7.0",
  "description": "Personal GitHub interface tweaks.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fractured GitHub",
    "default_icon": {
      "16": "icons/fractured-16.png",
      "32": "icons/fractured-32.png",
      "48": "icons/fractured-48.png",
      "128": "icons/fractured-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "features/pony-headings.css",
        "features/promote-display-names.css",
        "features/comment-highlights.css"
      ],
      "js": [
        "features/notifications/hide-inbox-while-busy.js",
        "features/interface/hide-copilot.js",
        "features/interface/hide-my-navigation-links.js",
        "features/interface/hide-hamburger-menu.js",
        "features/people/owner-avatar-header.js",
        "features/interface/rotating-404-fan-art.js",
        "features/people/profile-name-cache.js",
        "features/people/user-nicknames.js",
        "features/people/comment-highlights.js",
        "features/people/promote-display-names.js",
        "features/people/mute-users.js",
        "features/interface/block-tooltips.js",
        "features/pull-requests/hide-contributing-guidelines-notice.js",
        "features/pull-requests/hide-protip.js",
        "features/pull-requests/hide-milestone.js",
        "features/pull-requests/hide-empty-sections.js",
        "features/pull-requests/hide-participants.js",
        "features/pull-requests/hide-heading-actions.js",
        "features/interface/hide-footer.js",
        "features/repositories/hide-suggested-workflows.js",
        "features/repositories/hide-languages.js",
        "features/repositories/code-shortcuts.js",
        "features/repositories/hide-empty-description.js",
        "features/repositories/automatic-fork-setup.js",
        "features/repositories/hide-unused-tabs.js",
        "features/repositories/hide-social-actions.js",
        "features/notifications/organization.js",
        "features/interface/relative-times.js",
        "features/commits/title-emojis.js",
        "features/commits/message-simplifier.js",
        "features/notifications/hide-reason.js",
        "features/pull-requests/hide-empty-development-copy.js",
        "features/pull-requests/hide-coauthor-only-commit-details.js",
        "features/pull-requests/wrap-diff-lines.js",
        "features/pull-requests/toggle-sidebar.js",
        "features/writing/spellcheck/image-attachments.js",
        "features/writing/spellcheck/image-dialog.js",
        "features/writing/spellcheck/link-protection.js",
        "features/writing/spellcheck/issue-pr-drafts.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "features/writing/spellcheck/link-protection.js",
        "features/writing/spellcheck/chatgpt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/CelestiaMediumRedux.ttf",
        "icons/fractured.png"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/fractured-16.png",
    "32": "icons/fractured-32.png",
    "48": "icons/fractured-48.png",
    "128": "icons/fractured-128.png"
  },
  "host_permissions": [
    "https://derpibooru.org/*",
    "https://derpicdn.net/*"
  ]
}
